using System.CommandLine;
using System.ComponentModel.DataAnnotations;

var bundle = new Command("bundle", "bundle code files into one.");
var fb = new RootCommand("bundle files");
var output = new Option<FileInfo>("--output", "-o");
var note = new Option<bool>("--note", "-n");
var removeLines = new Option<bool>("--remove-empty-lines", "-rem");
var author = new Option<string>("--author", "-a");



var sort = new Option<string>("--sort", "-s")
{
    Description = "sort files by name or by type",
    DefaultValueFactory = _ => "name"
};

sort.AcceptOnlyFromAmong(["name", "type"]);

var languages = new Option<string[]>("--language", "-l")
{
    Description = "programming languages to include",
    Required = true,
    AllowMultipleArgumentsPerToken = true
};

string[] allowedLanguages = { "cs", "js", "py", "java", "html", "css" };

languages.AcceptOnlyFromAmong(["all", .. allowedLanguages]);
fb.Subcommands.Add(bundle);

bundle.Options.Add(sort);
bundle.Options.Add(note);
bundle.Options.Add(languages);
bundle.Options.Add(output);
bundle.Options.Add(removeLines);
bundle.Options.Add(author);




bundle.SetAction((parseResult) =>
{
    FileInfo fileInfo = parseResult.GetValue(output);
    var langs = parseResult.GetValue(languages);
  
  

    if (fileInfo != null)
    {


        try
        {
            File.Create(fileInfo.FullName);
            Console.WriteLine("flie created");


            
            
                string[] selected = parseResult.GetValue(languages)!;

                if (selected.Contains("all"))
                    selected = allowedLanguages;

                string[] excludedFolders = { "bin", "obj", ".vs", ".git", "node_modules" };

                List<string> files = Directory.GetFiles(Directory.GetCurrentDirectory(), "*", SearchOption.AllDirectories)
                    .Where(f => !excludedFolders.Any(ex =>
                        f.Split(Path.DirectorySeparatorChar).Contains(ex)))
                    .Where(f => selected.Contains(Path.GetExtension(f).TrimStart('.')))
                    .ToList();

                if (parseResult.GetValue(sort) == "type")
                    files.OrderBy(Path.GetExtension).ThenBy(Path.GetFileName).ToList();
                else files.OrderBy(Path.GetFileName).ToList();
            


            if (parseResult.GetValue(author) != null)
            {
                Console.WriteLine($"Author: {parseResult.GetValue(author)}");
            }
            if (parseResult.GetValue(note) == true)
            {
                Console.WriteLine("Note: This is a bundled file.path: ");
            }
            using var writer = new StreamWriter(output.Name);

            foreach (string file in files)
            {
                string[] lines = File.ReadAllLines(file);

                if (parseResult.GetValue(removeLines))
                {
                    lines = lines.Where(line => !string.IsNullOrWhiteSpace(line)).ToArray();
                }

                foreach (string line in lines)
                {
                    writer.WriteLine(line);
                }
            }
        }
        catch (DirectoryNotFoundException e)
        {
            Console.WriteLine("Error: invalid path.");
        }

    }

});


fb.Parse(args).InvokeAsync();
